<title>{{ p.title | xml_escape }}</title>
<link>https://euroscrape.github.io/apify-actors{{ p.url }}</link>
<guid isPermaLink="true">https://euroscrape.github.io/apify-actors{{ p.url }}</guid>
<description>{{ p.content | markdownify | strip_html | strip_newlines | truncate: 400 | xml_escape }}</description>
</item>
{%- endfor %}
